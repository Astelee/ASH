[shader_globals]

ashfall_rim_color={
"type": "color",
"value": Color(1, 0.85, 0.6, 1)
}
ashfall_wind_strength={
"type": "float",
"value": 0.35
}

[internationalization]

locale/translations=PackedStringArray("res://ui/strings.en.translation")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="enemy_body"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="player_hurtbox"
3d_physics/layer_6="enemy_hitbox"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_8="interactable"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
scaling_3d/mode=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
