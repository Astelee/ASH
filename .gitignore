# ---- Godot 4 ----
# Editor cache and generated import data. Never commit; it is machine-local and huge.
.godot/
# Godot 3 leftover, kept so a stray import dir can never sneak in.
.import/
# Generated translation binaries — the CSV is the source of truth.
*.translation

# ---- Secrets ----
# Godot 4.2+ writes keystore paths and passwords here, separate from export_presets.cfg.
# export_presets.cfg IS committed; this file is NOT.
export_credentials.cfg
*.keystore
*.jks
*.p12
*.pepk
keystore.properties
.env
.env.*

# ---- Android build ----
# Generated by "Install Android Build Template". Regenerate from the editor; see README.
android/build/
android/.gradle/
android/.idea/
android/local.properties
*.apk
*.aab
*.idsig

# ---- Export output ----
export/
build/
dist/

# ---- Tooling ----
.venv/
__pycache__/
*.pyc
.mypy_cache/
.gdlintrc.local

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Explicitly kept ----
# Lightmap bakes are committed on purpose (see CLAUDE.md, baked-lighting rule):
!*.lmbake
